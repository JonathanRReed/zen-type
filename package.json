{
  "$schema": "https://json.schemastore.org/package",
  "name": "zen-typer",
  "type": "module",
  "version": "1.1.0",
  "license": "MIT",
  "reactDoctor": {
    "rules": {
      "react-doctor/react-compiler-no-manual-memoization": "off",
      "react-doctor/prefer-html-dialog": "off",
      "react-doctor/insecure-crypto-risk": "off"
    }
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "doctor": "react-doctor .",
    "check": "astro check",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "verify": "bun run check && bun run lint && bun run test:run && bun run test:e2e",
    "health": "bun audit && bunx knip && bunx oxlint src e2e scripts && bunx react-doctor@latest ."
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/sitemap": "^3.7.6",
    "astro": "^7.4.13",
    "dexie": "^4.4.7",
    "diff": "^9.0.0",
    "fuse.js": "^7.5.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "devDependencies": {
    "@astrojs/react": "^7.1.9",
    "@axe-core/playwright": "^4.14.0",
    "@babel/core": "^8.1.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@rolldown/plugin-babel": "^0.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-doctor": "^0.9.23",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "6",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
