---
import AppLayout from "../layouts/AppLayout.astro";
import QuoteTyper from "../components/QuoteTyper";
import PassageBoot from "../components/PassageBoot.astro";
import NotesFoot from "../components/NotesFoot.astro";
import { loadQuotes, pickQuote } from "../utils/quotes";

const quotes = await loadQuotes();
const quote = pickQuote(quotes);
const siteUrl = "https://zentype.jonathanrreed.com";
const quoteUrl = `${siteUrl}/quote/`;
---

<AppLayout
	mode="quote"
	heading="Zen Quote Typing Test for Speed and Accuracy"
	seo={{
		title: "Quote Mode | Zen Typer Typing Speed Practice",
		description:
			"Take a mindful typing test on short Zen quotes with live WPM, accuracy tracking, and an error breakdown. No account, and your stats stay in the browser.",
		canonical: quoteUrl,
		keywords: ["typing test", "typing speed test", "WPM test", "typing accuracy", "Zen quotes", "typing practice"],
		breadcrumbItems: [
			{ name: "Mindful typing test", url: `${siteUrl}/` },
			{ name: "Zen quote typing test", url: quoteUrl },
		],
	}}
>
	<QuoteTyper client:only="react" quote={quote.text} author={quote.author} source={quote.source ?? ""} quoteId={quote.id} />
	<PassageBoot text={quote.text} author={quote.author} source={quote.source ?? ""} />

	<section slot="notes" class="notes" aria-labelledby="quote-notes-heading">
		<div class="notes-inner">
			<header class="notes-head">
				<h2 id="quote-notes-heading">A Zen quote typing test with WPM and accuracy.</h2>
				<p>
					Each round is one short passage with live accuracy feedback and WPM tracking. It is built for clean
					repetition, not for winning a race.
				</p>
			</header>

			<dl class="notes-grid">
				<div>
					<dt>What you type</dt>
					<dd>
						{quotes.length} passages from Marcus Aurelius, Epictetus, Lao Tzu, Thoreau, Emerson, Okakura's Book of
						Tea, and others, each with its book and translator named under it. Filter them by length or by subject
						in Settings, or paste in a text of your own.
					</dd>
				</div>
				<div>
					<dt>What you see at the end</dt>
					<dd>
						Words per minute, accuracy, and the time it took, with your mistakes counted as wrong keys, early
						spaces, and missed spaces. Enter brings the next passage.
					</dd>
				</div>
				<div>
					<dt>Setting a pace</dt>
					<dd>
						Choose a target speed in Settings and a quiet marker walks through the passage at that pace, so you
						can practice holding a rhythm instead of sprinting.
					</dd>
				</div>
				<div>
					<dt>Where the numbers go</dt>
					<dd>
						Into your browser and nowhere else. The Progress view keeps a calendar of the days you practiced and
						a line of your recent speeds. The <a href="/privacy/">privacy notice</a> has the detail.
					</dd>
				</div>
			</dl>

			<NotesFoot current="/quote/" />
		</div>
	</section>
</AppLayout>
