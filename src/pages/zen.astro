---
import AppLayout from "../layouts/AppLayout.astro";
import ZenCanvas from "../components/ZenCanvas";
import NotesFoot from "../components/NotesFoot.astro";

const siteUrl = "https://zentype.jonathanrreed.com";
const zenUrl = `${siteUrl}/zen/`;
---

<AppLayout
	mode="zen"
	heading="Free-Flow Typing Practice for Focused Writing"
	seo={{
		title: "Zen Mode | Free-Flow Typing Practice",
		description:
			"Zen Mode is free-flow typing practice. Words drift up the canvas as you commit them, and session stats stay local to your browser. No account needed.",
		canonical: zenUrl,
		keywords: ["typing practice", "free-flow typing", "mindful typing", "typing trainer", "focused writing", "writing practice"],
		breadcrumbItems: [
			{ name: "Mindful typing test", url: `${siteUrl}/` },
			{ name: "Free-flow typing practice", url: zenUrl },
		],
	}}
>
	<ZenCanvas client:only="react" maxTokens={160} />

	<section slot="notes" class="notes" aria-labelledby="zen-notes-heading">
		<div class="notes-inner">
			<header class="notes-head">
				<h2 id="zen-notes-heading">Typing practice for focused writing sessions.</h2>
				<p>
					Zen Mode turns typing practice into an open writing flow. Words rise through the page as you finish
					them while a quiet line tracks pace and time without breaking focus.
				</p>
			</header>

			<dl class="notes-grid">
				<div>
					<dt>How it works</dt>
					<dd>
						Each word you finish lifts off the line and drifts away, so there is a sense of progress without
						turning the page into a scoreboard. Good for warmups, note fragments, and early drafting where
						getting words down matters more than polishing them.
					</dd>
				</div>
				<div>
					<dt>What is kept</dt>
					<dd>
						Everything you write is saved as a draft in your browser, with its earlier versions. It is not a
						replacement for a full editor, just a low-friction place to start. The <a href="/privacy/">privacy notice</a> has the detail.
					</dd>
				</div>
				<div>
					<dt>A timer, if it helps</dt>
					<dd>
						Set three, five, or ten minutes in Settings and a chime tells you when the time is up. Leave it off
						and the page stays open as long as you do.
					</dd>
				</div>
			</dl>

			<NotesFoot current="/zen/" />
		</div>
	</section>
</AppLayout>
