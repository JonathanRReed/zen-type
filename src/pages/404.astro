---
import PageLayout from "../layouts/PageLayout.astro";

const siteUrl = "https://zentype.jonathanrreed.com";
---

<PageLayout
	title="This page wandered off"
	seo={{
		title: "Page Not Found | Zen Typer",
		description: "That Zen Typer page does not exist. Return to the mindful typing test or the free-flow writing mode.",
		canonical: `${siteUrl}/404/`,
		noindex: true,
		breadcrumbItems: [
			{ name: "Mindful typing test", url: `${siteUrl}/` },
		],
	}}
>
	<p slot="lede" class="prose-lede">
		There is nothing to type here. The quote test and the free-flow canvas are both one step away.
	</p>

	<div class="prose-links">
		<a class="btn btn-primary" href="/">Mindful typing test</a>
		<a class="btn btn-outline" href="/quote/">Quote typing test</a>
		<a class="btn btn-outline" href="/zen/">Free-flow typing practice</a>
	</div>
</PageLayout>
