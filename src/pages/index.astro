---
import AppLayout from "../layouts/AppLayout.astro";
import QuoteTyper from "../components/QuoteTyper";
import PassageBoot from "../components/PassageBoot.astro";
import Shelf from "../components/Shelf.astro";
import NotesFoot from "../components/NotesFoot.astro";
import { loadQuotes, pickQuote } from "../utils/quotes";
import { THEME_NAMES } from "../utils/storage";

const quotes = await loadQuotes();
const quote = pickQuote(quotes);
const writers = new Set(quotes.filter((q) => q.author !== "Proverb").map((q) => q.author)).size;
const siteUrl = "https://zentype.jonathanrreed.com";
const homeUrl = `${siteUrl}/`;
const themeList = THEME_NAMES.join(", ");

const webApplicationJsonLd = {
	"@context": "https://schema.org",
	"@type": "WebApplication",
	"@id": `${homeUrl}#webapp`,
	name: "Zen Typer",
	alternateName: "ZenType",
	url: homeUrl,
	description:
		"A free mindful typing test and typing practice app. Type short Zen quotes with live WPM and accuracy, or switch to a free-flow writing mode. No account, and sessions stay in the browser.",
	applicationCategory: "EducationalApplication",
	applicationSubCategory: "Typing test",
	operatingSystem: "Any device with a modern web browser",
	browserRequirements: "Requires JavaScript.",
	inLanguage: "en-US",
	isAccessibleForFree: true,
	offers: {
		"@type": "Offer",
		price: "0",
		priceCurrency: "USD",
		availability: "https://schema.org/InStock",
	},
	featureList: [
		`Quote typing test with live WPM and accuracy on ${quotes.length} public-domain quotes`,
		"Custom text practice with any passage you paste in",
		"Free-flow Zen Mode with drafts and an optional timed flow",
		"Progress calendar, day streak, and session history",
		"Synthesized keyboard sounds and ambient beds, off by default",
		`${THEME_NAMES.length} themes with WebGL ambient scenes and reduced-motion support`,
		"Backup and restore of all data as one file; nothing leaves the browser",
	],
	creator: { "@id": `${homeUrl}#creator` },
	publisher: { "@id": `${homeUrl}#creator` },
	isPartOf: { "@id": `${homeUrl}#website` },
};
---

<AppLayout
	mode="quote"
	heading="Mindful Typing Test and Practice"
	seo={{
		title: "Mindful Typing Test and Practice for Focus | Zen Typer",
		description:
			"Zen Typer is a free mindful typing test with Zen quotes, live WPM and accuracy, and a free-flow writing mode. No account, and sessions stay in your browser.",
		canonical: homeUrl,
		jsonLd: webApplicationJsonLd,
		keywords: ["typing test", "mindful typing test", "typing practice", "typing trainer", "WPM test", "typing accuracy"],
		breadcrumbItems: [{ name: "Mindful typing test", url: homeUrl }],
	}}
>
	<QuoteTyper client:only="react" quote={quote.text} author={quote.author} source={quote.source ?? ""} quoteId={quote.id} />
	<PassageBoot text={quote.text} author={quote.author} source={quote.source ?? ""} />

	<section slot="notes" class="notes" aria-labelledby="home-notes-heading">
		<div class="notes-inner">
			<header class="notes-head">
				<h2 id="home-notes-heading">A mindful typing test for focus, speed, and accuracy.</h2>
				<p>
					Zen Typer is a browser typing test built around short passages from old books, with a second mode that is
					just a blank page for open writing. It runs entirely on your own machine.
				</p>
			</header>

			<dl class="notes-grid">
				<div>
					<dt>How the test works</dt>
					<dd>
						One passage at a time. The timer starts on your first keystroke and stops on the final character, so
						reading the quote first costs you nothing. Backspace rewinds to the last mistake instead of one
						character at a time.
					</dd>
				</div>
				<div>
					<dt>How are WPM and accuracy calculated?</dt>
					<dd>
						Words per minute is your correct characters divided by five, then divided by the elapsed minutes, using
						the standard five-character word. Accuracy is correct characters divided by every character you typed.
						Mistakes are sorted into wrong keys, early spaces, and missed spaces so you can see the pattern, not
						just the score.
					</dd>
				</div>
				<div>
					<dt>What is stored</dt>
					<dd>
						Settings, session stats, the day streak, your last 500 sessions, and Zen Mode drafts are written to your
						browser's local storage and IndexedDB. There is no account and no sync, so clearing site data for this
						domain removes them. The <a href="/privacy/">privacy notice</a> has the full detail.
					</dd>
				</div>
				<div>
					<dt>Two modes</dt>
					<dd>
						A <a href="/quote/">quote typing test</a> that measures you, and a <a href="/zen/">free-flow canvas</a> called Zen Mode that does not.
					</dd>
				</div>
				<div>
					<dt>Your own text</dt>
					<dd>
						Paste a paragraph you are learning, a speech, or the opening of a book, and practice on that instead.
						It is never saved or sent anywhere.
					</dd>
				</div>
				<div>
					<dt>Live while you type</dt>
					<dd>Words per minute, accuracy, elapsed time, and a day streak, in one quiet line you can switch off.</dd>
				</div>
				<div>
					<dt>{THEME_NAMES.length} themes</dt>
					<dd>{themeList}. Each is a scene drawn live, and each holds still when you ask for reduced motion.</dd>
				</div>
				<div>
					<dt>Sound, if you want it</dt>
					<dd>
						Keyboard switches and ambient rain, wind, or fire, synthesized in the browser and off until you turn
						them on.
					</dd>
				</div>
				<div>
					<dt>Take it with you</dt>
					<dd>Back everything up to one file and restore it anywhere. Free, no account, nothing sent to a server.</dd>
				</div>
			</dl>

			<section class="notes-shelf" aria-labelledby="shelf-heading">
				<div class="notes-shelf-head">
					<h3 id="shelf-heading">On the shelf</h3>
					<p>
						{quotes.length} passages from {writers} writers and a handful of proverbs, every one from a public-domain
						edition with its source named. The number is how many passages each contributes.
					</p>
				</div>
				<Shelf />
			</section>

			<NotesFoot current="/" />
		</div>
	</section>
</AppLayout>
